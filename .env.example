NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# https://dev.twitch.tv/console/apps (IGDB uses Twitch OAuth)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# openssl rand -hex 32 — also set in Vercel; Vercel Cron sends it as a Bearer token
CRON_SECRET=

# Only for Docker with local Supabase: how the container reaches it
# DOCKER_SUPABASE_URL=http://host.docker.internal:54321
